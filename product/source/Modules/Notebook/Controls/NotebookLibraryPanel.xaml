<ui:CompositePanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Notarium.UI;assembly=Notarium.UI" xmlns:local="clr-namespace:Notatnik" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf" x:Class="Notatnik.NotebookLibraryPanel">
    <ui:CompositePanel.Resources>
        <BooleanToVisibilityConverter x:Key="RowHoverVisibility" />
        <local:FavoriteButtonVisibilityConverter x:Key="FavoriteButtonVisibility" />
    </ui:CompositePanel.Resources>
    <Grid Background="{StaticResource Panel}">
                <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <ui:ActionButton Width="28" Height="28" HorizontalAlignment="Left" Margin="10,0,0,0" Padding="0" ToolTip="Ukryj panel boczny" Click="SidebarIcon_Click" AutomationProperties.Name="Ukryj panel boczny"><ui:BrandIcon Width="28" Height="28" /></ui:ActionButton>
                    <TextBlock Text="Notatnik" Foreground="{StaticResource Text}" Margin="47,0,6,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </Grid>

                <Grid Grid.Row="1" Margin="6,3,6,7">
                    <Border Background="#2B2B2B" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="5" />
                    <TextBlock Text="⌕" FontSize="19" Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Margin="34,0,39,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="White" FontSize="13" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchHint" Text="Szukaj" Margin="36,0,39,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsHitTestVisible="False" />
                    <ui:ActionButton Content="＋" ToolTip="Utwórz nową notatkę" HorizontalAlignment="Right" Width="34" Height="32" Margin="0,0,2,0" Padding="0" FontSize="18" Background="#3B82D0" Foreground="White" FontWeight="SemiBold" Click="NewNote_Click" />
                </Grid>


                <ListBox Grid.Row="2" x:Name="NotesList" ItemsSource="{Binding Notes}" SelectedItem="{Binding ActiveNote, Mode=OneWay}" SelectionChanged="NotesList_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="5,0" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Padding="9,5" BorderBrush="#353535" BorderThickness="0,0,0,1" CornerRadius="4" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2D2D2D" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Selected}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="21" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                                <Grid Grid.Row="0">
                                    <emoji:TextBlock x:Name="SideTitle" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MouseLeftButtonDown="SidebarTitle_MouseLeftButtonDown" />
                                    <emoji:TextBox local:InlineTitleEditor.Dark="True" x:Name="SideTitleEditor" Tag="{Binding Id}" Text="{Binding Title, Mode=OneWay}" Visibility="Collapsed" Height="22" Padding="3,0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Text}" CaretBrush="White" KeyDown="InlineTitle_KeyDown" LostFocus="InlineTitle_LostFocus" />
                                </Grid>
                                <emoji:TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Preview}" FontSize="9" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" LineHeight="21" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                                <Grid Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="25" /></Grid.ColumnDefinitions>
                                    <ui:SidebarRowIconButton Grid.Column="0" x:Name="TrashButton" Tag="{Binding Id}" ToolTip="Usuń notatkę" AutomationProperties.Name="Usuń notatkę" Click="DeleteNoteFromList_Click" Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Converter={StaticResource RowHoverVisibility}}">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#777777" /><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ui:SidebarRowIconButton}}}" Value="True"><Setter Property="Foreground" Value="#C8C8C8" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </ui:SidebarRowIconButton>
                                    <ui:SidebarRowIconButton Grid.Column="1" Tag="{Binding Id}" ToolTip="Dodaj lub usuń z ulubionych" AutomationProperties.Name="Dodaj lub usuń z ulubionych" Click="SidebarFavoriteButton_Click" Foreground="{Binding FavoriteColor}" FontSize="18.7">
                                        <ui:SidebarRowIconButton.Visibility>
                                            <MultiBinding Converter="{StaticResource FavoriteButtonVisibility}">
                                                <Binding Path="IsFavorite" />
                                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType={x:Type ListBoxItem}}" />
                                            </MultiBinding>
                                        </ui:SidebarRowIconButton.Visibility>
                                        <TextBlock Text="{Binding FavoriteGlyph}" LineHeight="21" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding FavoriteColor}" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsFavorite}" Value="False" /><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ui:SidebarRowIconButton}}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="#C8C8C8" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </ui:SidebarRowIconButton>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsRenamingInSidebar}" Value="True"><Setter TargetName="SideTitle" Property="Visibility" Value="Collapsed" /><Setter TargetName="SideTitleEditor" Property="Visibility" Value="Visible" /></DataTrigger></DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="6,10,6,10">
                    <StackPanel>
                        <ui:ActionButton ToolTip="Konto — makieta" Height="32" Padding="9,2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Foreground="{StaticResource Text}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,2,0,0" /><TextBlock Grid.Column="1" Text="Konto" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></Grid>
                        </ui:ActionButton>
                        <ui:ActionButton ToolTip="Ustawienia — makieta" Height="32" Padding="9,2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Foreground="{StaticResource Text}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,2,0,0" /><TextBlock Grid.Column="1" Text="Ustawienia" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></Grid>
                        </ui:ActionButton>
                    </StackPanel>
                </Border>

            </Grid></ui:CompositePanel>
