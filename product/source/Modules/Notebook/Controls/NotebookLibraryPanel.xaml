<ui:CompositePanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Notarium.UI;assembly=Notarium.UI" xmlns:local="clr-namespace:Notatnik" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf" x:Class="Notatnik.NotebookLibraryPanel"><Grid Background="{StaticResource Panel}">
                <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <ui:BrandIcon Width="28" Height="28" HorizontalAlignment="Left" Margin="10,0,0,0" />
                    <TextBlock Text="Notarium Notatnik" Foreground="{StaticResource Text}" Margin="47,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                </Grid>

                <Grid Grid.Row="1" Margin="6,3,6,7">
                    <Border Background="#2B2B2B" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="5" />
                    <TextBlock Text="⌕" FontSize="19" Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Margin="34,0,39,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="White" FontSize="13" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchHint" Text="Szukaj" Margin="36,0,39,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <ui:ActionButton Content="＋" ToolTip="Utwórz nową notatkę" HorizontalAlignment="Right" Width="34" Height="32" Margin="0,0,2,0" Padding="0" FontSize="18" Background="#3B82D0" Foreground="White" FontWeight="SemiBold" Click="NewNote_Click" />
                </Grid>


                <ListBox Grid.Row="2" x:Name="NotesList" ItemsSource="{Binding Notes}" SelectedItem="{Binding ActiveNote, Mode=OneWay}" SelectionChanged="NotesList_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="4,0" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Padding="9,5" BorderBrush="#353535" BorderThickness="0,0,0,1" CornerRadius="4" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2D2D2D" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Selected}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="21" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="31" /></Grid.ColumnDefinitions><Grid Grid.Row="0"><emoji:TextBlock x:Name="SideTitle" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MouseLeftButtonDown="SidebarTitle_MouseLeftButtonDown" /><emoji:TextBox local:InlineTitleEditor.Dark="True" x:Name="SideTitleEditor" Tag="{Binding Id}" Text="{Binding Title, Mode=OneWay}" Visibility="Collapsed" Height="22" Padding="3,0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Text}" CaretBrush="White" KeyDown="InlineTitle_KeyDown" LostFocus="InlineTitle_LostFocus" /></Grid><ui:ActionButton Grid.Row="1" Grid.Column="0" Tag="{Binding Id}" ToolTip="Dodaj lub usuń z ulubionych" Click="SidebarFavoriteButton_Click" Foreground="{Binding FavoriteColor}" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="22" Height="21" Margin="-3,0,0,0" Padding="0" FontSize="18.7"><TextBlock Text="{Binding FavoriteGlyph}" LineHeight="21" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" VerticalAlignment="Center" /></ui:ActionButton><emoji:TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Preview}" FontSize="9" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="25,0,0,0" LineHeight="21" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" /><ui:ActionButton Grid.RowSpan="2" Grid.Column="1" Content="" FontFamily="Segoe MDL2 Assets" Tag="{Binding Id}" ToolTip="Usuń notatkę" Click="DeleteNoteFromList_Click" Width="27" Height="27" Margin="8,0,-8,0" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{StaticResource Muted}" VerticalAlignment="Center" /></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsRenamingInSidebar}" Value="True"><Setter TargetName="SideTitle" Property="Visibility" Value="Collapsed" /><Setter TargetName="SideTitleEditor" Property="Visibility" Value="Visible" /></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,10,8,20">
                    <StackPanel>
                        <ui:ActionButton ToolTip="Konto — makieta" Height="32" Padding="9,2" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="{StaticResource Text}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" Foreground="{StaticResource Accent}" VerticalAlignment="Center" /><TextBlock Text="Konto" FontSize="13" VerticalAlignment="Center" /></StackPanel>
                        </ui:ActionButton>
                        <ui:ActionButton ToolTip="Ustawienia — makieta" Height="32" Padding="9,2" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="{StaticResource Text}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" Foreground="{StaticResource Accent}" VerticalAlignment="Center" /><TextBlock Text="Ustawienia" FontSize="13" VerticalAlignment="Center" /></StackPanel>
                        </ui:ActionButton>
                    </StackPanel>
                </Border>

            </Grid></ui:CompositePanel>
