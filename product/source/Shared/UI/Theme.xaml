<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Notarium.UI">
        <SolidColorBrush x:Key="TitleBar" Color="#202020"/><SolidColorBrush x:Key="CommandBar" Color="#272727"/>
        <SolidColorBrush x:Key="Panel" Color="{Binding Panel, Source={x:Static ui:UiPolicy.Current}}"/><SolidColorBrush x:Key="Editor" Color="{Binding Surface, Source={x:Static ui:UiPolicy.Current}}"/>
        <SolidColorBrush x:Key="Selected" Color="#3B3B3B"/><SolidColorBrush x:Key="Line" Color="#3D3D3D"/>
        <SolidColorBrush x:Key="Text" Color="{Binding MenuText, Source={x:Static ui:UiPolicy.Current}}"/><SolidColorBrush x:Key="Muted" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="Accent" Color="{Binding Accent, Source={x:Static ui:UiPolicy.Current}}"/>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Editor}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="B" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource Selected}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource CommandBar}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#353535"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#454545"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{Binding DisabledOpacity, Source={x:Static ui:UiPolicy.Current}}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="12,7"/></Style>
</ResourceDictionary>
