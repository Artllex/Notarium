<Window x:Class="Notatnik.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Notatnik" xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="Notarium" Width="1180" Height="760" MinWidth="760" MinHeight="480"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}" MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Editor}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStyle="None" ResizeMode="CanResize" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#414141" BorderThickness="1" CornerRadius="7" Background="{StaticResource Editor}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource TitleBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Notarium" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text}"/>
                <Button Grid.Column="1" Content="—" FontSize="12" Padding="4" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="2" Content="□" FontSize="13" Padding="4" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="3" Content="×" FontSize="16" Padding="4" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
            <Menu Grid.Row="1" Grid.ColumnSpan="3" Background="#202020" Foreground="{StaticResource Text}" BorderThickness="0"
                  FontFamily="Segoe UI" FontSize="12" Padding="5,0" VerticalContentAlignment="Center">
                    <MenuItem Header="_File" Foreground="{StaticResource Text}"><MenuItem Header="_New note" Foreground="#202020" InputGestureText="Ctrl+N" Click="NewNote_Click"/><MenuItem Header="_Open file…" Foreground="#202020" InputGestureText="Ctrl+O" Click="OpenFile_Click"/><MenuItem Header="_Save active note as…" Foreground="#202020" InputGestureText="Ctrl+S" Click="SaveFile_Click"/><Separator/><MenuItem Header="_Delete note" Foreground="#202020" Click="DeleteNote_Click"/><Separator/><MenuItem Header="E_xit" Foreground="#202020" Click="Exit_Click"/></MenuItem>
                    <MenuItem Header="_Edit" Foreground="{StaticResource Text}"><MenuItem Header="_Undo" Foreground="#202020" InputGestureText="Ctrl+Z" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}"/><MenuItem Header="_Redo" Foreground="#202020" InputGestureText="Ctrl+Y" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}"/></MenuItem>
                    <MenuItem Header="_Help" Foreground="{StaticResource Text}"><MenuItem Header="_About Notarium" Foreground="#202020" Click="HelpMenu_Click"/></MenuItem>
            </Menu>

            <!-- Lewy panel w stylu RemNote -->
            <Grid Grid.Row="2" Grid.Column="0" Background="{StaticResource Panel}">
                <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#2563A6" HorizontalAlignment="Left" Margin="14,0,0,0">
                        <TextBlock Text="✦" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Notarium" Margin="51,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                </Grid>

                <Grid Grid.Row="1" Margin="10,3,10,7">
                    <Border Background="#2B2B2B" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="5"/>
                    <TextBlock Text="⌕" FontSize="19" Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Margin="34,0,39,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="White" FontSize="13" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Szukaj" Margin="36,0,39,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Button Content="＋" ToolTip="Utwórz nową notatkę" HorizontalAlignment="Right" Width="34" Height="32" Margin="0,0,2,0"
                            Padding="0" FontSize="18" Background="#3B82D0" Foreground="White" FontWeight="SemiBold" Click="NewNote_Click"/>
                </Grid>

                <TextBlock Grid.Row="2" Text="NOTATKI" Margin="17,13,0,7" Foreground="#8B8B8B" FontSize="10" FontWeight="SemiBold"/>

                <ListBox Grid.Row="3" x:Name="NotesList" ItemsSource="{Binding Notes}" SelectedItem="{Binding ActiveNote, Mode=OneWay}" SelectionChanged="NotesList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" Padding="8,0" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Padding="9,5" BorderBrush="#353535" BorderThickness="0,0,0,1" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2D2D2D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Selected}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="21"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="31"/></Grid.ColumnDefinitions><Grid Grid.Row="0"><emoji:TextBlock x:Name="SideTitle" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MouseLeftButtonDown="SidebarTitle_MouseLeftButtonDown"/><emoji:TextBox local:InlineTitleEditor.Dark="True" x:Name="SideTitleEditor" Tag="{Binding Id}" Text="{Binding Title, Mode=OneWay}" Visibility="Collapsed" Height="22" Padding="3,0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Text}" CaretBrush="White" KeyDown="InlineTitle_KeyDown" LostFocus="InlineTitle_LostFocus"/></Grid><Button Grid.Row="1" Grid.Column="0" Tag="{Binding Id}" ToolTip="Dodaj lub usuń z ulubionych" Click="SidebarFavoriteButton_Click" Foreground="{Binding FavoriteColor}" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="22" Height="21" Margin="-3,0,0,0" Padding="0" FontSize="18.7"><TextBlock Text="{Binding FavoriteGlyph}" LineHeight="21" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" VerticalAlignment="Center"/></Button><emoji:TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Preview}" FontSize="9" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="25,0,0,0" LineHeight="21" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/><Button Grid.RowSpan="2" Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding Id}" ToolTip="Usuń notatkę" Click="DeleteNoteFromList_Click" Width="27" Height="27" Margin="8,0,-8,0" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#B8B8B8" VerticalAlignment="Center"/></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding IsRenamingInSidebar}" Value="True"><Setter TargetName="SideTitle" Property="Visibility" Value="Collapsed"/><Setter TargetName="SideTitleEditor" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,10,8,20">
                    <StackPanel>
                        <Button ToolTip="Konto — makieta" Height="32" Padding="9,2" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="{StaticResource Muted}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Konto" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button ToolTip="Ustawienia — makieta" Height="32" Padding="9,2" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="{StaticResource Muted}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Ustawienia" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>

            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Line}" Margin="0,34,0,0"/>

            <!-- Główna część: lekkie karty i edytor -->
            <Grid Grid.Row="2" Grid.Column="2" Background="{StaticResource Editor}">
                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto" MinHeight="30"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{StaticResource Editor}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid x:Name="TabsHost" SizeChanged="TabsHost_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="LeftTabsButton" Content="‹" Width="30" Margin="2,3,0,2" FontSize="19" Visibility="Collapsed" Click="PreviousTabs_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding VisibleTabs}" ClipToBounds="True">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Width="{Binding DataContext.TabWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="34" Margin="-7,2,0,0" MouseLeftButtonDown="Tab_MouseLeftButtonDown" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Path x:Name="TabBase" Stretch="Fill" Fill="Transparent" Data="M 14,36 L 0,36 L 8,5 Q 9,0 15,0 L 185,0 Q 191,0 192,5 L 200,36 L 186,36 Z"/>
                                    <Path x:Name="HoverShape" Stretch="Fill" Fill="#505050" Opacity="0" IsHitTestVisible="False" Data="M 14,36 L 0,36 L 8,5 Q 9,0 15,0 L 185,0 Q 191,0 192,5 L 200,36 L 186,36 Z">
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Mouse.MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></EventTrigger>
                                            <EventTrigger RoutedEvent="Mouse.MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <Grid Margin="18,0,14,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid><emoji:TextBlock x:Name="TabTitle" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" MouseLeftButtonDown="TabTitle_MouseLeftButtonDown"/><emoji:TextBox local:InlineTitleEditor.Dark="True" x:Name="TabTitleEditor" Tag="{Binding Note.Id}" Text="{Binding Note.Title, Mode=OneWay}" Visibility="Collapsed" Height="25" Padding="4,1" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Text}" CaretBrush="White" KeyDown="InlineTitle_KeyDown" LostFocus="InlineTitle_LostFocus"/></Grid>
                                        <Button Grid.Column="1" Content="×" Tag="{Binding}" Click="CloseTab_Click" Padding="5,1" FontSize="16" Foreground="{StaticResource Muted}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="TabBase" Property="Fill" Value="#333333"/></DataTrigger><DataTrigger Binding="{Binding Note.IsRenamingInTab}" Value="True"><Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed"/><Setter TargetName="TabTitleEditor" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Column="2" x:Name="RightTabsButton" Content="›" Width="30" Margin="2,3,2,2" FontSize="19" Visibility="Collapsed" Click="NextTabs_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Grid.Column="3" Content="＋" ToolTip="Nowa notatka" Width="36" Margin="1,1" FontSize="18" Click="NewNote_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </Grid>
                </Grid>
                <Border Grid.Row="1" Background="#262626">
                    <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                        <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="7,1"/></Style></StackPanel.Resources>
                        <Button Content="↶" ToolTip="Cofnij" Tag="undo" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="17"/>
                        <Button Content="↷" ToolTip="Ponów" Tag="redo" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="17"/>
                        <Border Width="1" Height="17" Background="#505050" Margin="5,0"/>
                        <Button Content="H" ToolTip="Nagłówek" Tag="heading" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                        <Button Content="B" ToolTip="Pogrubienie (Ctrl+B)" Tag="bold" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="15"/>
                        <Button Content="I" ToolTip="Kursywa (Ctrl+I)" Tag="italic" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontStyle="Italic" FontSize="15"/>
                        <Button Content="S̶" ToolTip="Przekreślenie" Tag="strike" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="14"/>
                        <Border Width="1" Height="17" Background="#505050" Margin="5,0"/>
                        <StackPanel Orientation="Horizontal" ToolTip="Wyrównanie">
                            <Button Content="&#xE8E4;" FontFamily="Segoe MDL2 Assets" Width="30" Padding="4,4,4,0" ToolTip="Wyrównaj do lewej (Ctrl+Shift+L)" Tag="alignLeft" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="14"/>
                            <Button Content="&#xE8E3;" FontFamily="Segoe MDL2 Assets" Width="30" Padding="4,4,4,0" ToolTip="Wyśrodkuj (Ctrl+Shift+E)" Tag="alignCenter" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="14"/>
                            <Button Content="&#xE8E2;" FontFamily="Segoe MDL2 Assets" Width="30" Padding="4,4,4,0" ToolTip="Wyrównaj do prawej (Ctrl+Shift+R)" Tag="alignRight" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="14"/>
                            <Button Content="&#xE8E1;" FontFamily="Segoe MDL2 Assets" Width="30" Padding="4,4,4,0" ToolTip="Wyjustuj (Ctrl+Shift+J)" Tag="alignJustify" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="14"/>
                        </StackPanel>
                        <Border Width="1" Height="17" Background="#505050" Margin="5,0"/>
                        <Button x:Name="FontFamilyButton" Content="Segoe UI ▾" Width="132" HorizontalContentAlignment="Left" ToolTip="Wybierz czcionkę" Tag="fontfamily" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="11"/>
                        <Button x:Name="LineSpacingButton" Content="↕ 1,25" ToolTip="Interlinia" Tag="linespacing" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="11"/>
                        <Button x:Name="ContentWidthButton" Content="↔ 790" Width="49" Padding="2,1" ToolTip="Szerokość składu" Tag="contentwidth" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="11"/>
                        <Grid Width="42" Height="26" ToolTip="Kolor tekstu"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                            <Button x:Name="FontColorButton" Grid.Column="0" Padding="0" Click="ToggleFontColor_Click" ToolTip="Włącz lub wyłącz ostatni kolor tekstu">
                                <Grid Width="22" Height="24"><TextBlock Text="A" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top"/><Border x:Name="FontColorSwatch" Height="3" Background="#E76F6F" VerticalAlignment="Bottom" Margin="2,0"/></Grid>
                            </Button>
                            <Button Grid.Column="1" Padding="0" Click="FontColorMenu_Click" ToolTip="Wybierz kolor tekstu"><TextBlock Text="⌄" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/></Button>
                        </Grid>
                        <Grid Width="42" Height="26" ToolTip="Kolor podświetlenia"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                            <Button x:Name="HighlightColorButton" Grid.Column="0" Padding="0" Click="ToggleHighlightColor_Click" ToolTip="Włącz lub wyłącz ostatnie podświetlenie">
                                <Grid Width="22" Height="24"><TextBlock Text="▰" Foreground="{StaticResource Accent}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Top"/><Border x:Name="HighlightColorSwatch" Height="3" Background="#F4D35E" VerticalAlignment="Bottom" Margin="2,0"/></Grid>
                            </Button>
                            <Button Grid.Column="1" Padding="0" Click="HighlightColorMenu_Click" ToolTip="Wybierz kolor podświetlenia"><TextBlock Text="⌄" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/></Button>
                        </Grid>
                        <Border Width="1" Height="17" Background="#505050" Margin="5,0"/>
                        <Button Content="⌁" ToolTip="Link" Tag="link" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="17"/>
                        <Button Content="&lt;/&gt;" ToolTip="Kod w tekście" Tag="code" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontFamily="Consolas"/>
                        <Button Content="∑" ToolTip="Wstaw wzór LaTeX" Tag="math" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="16"/>
                        <Button Content="&#xEB9F;" FontFamily="Segoe MDL2 Assets" ToolTip="Wstaw obraz" Tag="image" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="14"/>
                        <Button Content="▦" ToolTip="Wstaw lub edytuj tabelę" Tag="table" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="16"/>
                        <Border Width="1" Height="17" Background="#505050" Margin="5,0"/>
                        <Button Content="•≡" ToolTip="Lista punktowana" Tag="bullet" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="15"/>
                        <Button Content="1≡" ToolTip="Lista numerowana" Tag="numbered" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="14"/>
                        <Button Content="☑≡" ToolTip="Lista zadań" Tag="checklist" Click="MarkdownButton_Click" Foreground="{StaticResource Accent}" FontSize="14"/>
                    </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Border>
                <Border Grid.Row="4" Background="#262626" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <Grid>
                    <Grid VerticalAlignment="Center" Margin="12,0,110,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ActiveNote.CreatedAtText}" Foreground="{StaticResource Muted}" FontSize="10"/>
                        <TextBlock Grid.Column="1" Text="{Binding ActiveNote.SavedAtText}" ToolTip="{Binding ActiveNote.SavedAtText}" TextTrimming="CharacterEllipsis" Margin="18,0,0,0" Foreground="{StaticResource Muted}" FontSize="10"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Content="−" ToolTip="Pomniejsz tekst" Width="25" Height="24" Padding="0" FontSize="15" Foreground="{StaticResource Accent}" Click="ZoomOut_Click"/>
                        <Button x:Name="ZoomButton" Content="100%" ToolTip="Wybierz powiększenie" Width="46" Height="24" Padding="1,0" Foreground="{StaticResource Muted}" FontSize="10" Click="ZoomMenu_Click"/>
                        <Button Content="+" ToolTip="Powiększ tekst" Width="25" Height="24" Padding="0" FontSize="15" Foreground="{StaticResource Accent}" Click="ZoomIn_Click"/>
                    </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource Line}"/>
                <Grid Grid.Row="3">
                    <local:WebEditorControl x:Name="Editor" HorizontalAlignment="Stretch" Background="{StaticResource Editor}"/>
                    <Button Content="{Binding ActiveNote.FavoriteGlyph}" ToolTip="Dodaj lub usuń z ulubionych" Width="38" Height="38"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,18,0" Padding="0" FontSize="23"
                            Foreground="{Binding ActiveNote.FavoriteColor}" Background="#2D2D2D" Click="FavoriteButton_Click"/>
                    <Button Content="?" Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Background="#2D2D2D" Foreground="{StaticResource Text}" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
